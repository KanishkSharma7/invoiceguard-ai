DATABASE_URL=postgresql://invoiceguard:local_dev_only@localhost:5433/invoiceguard?schema=public
# Development/test default is url. Production requires rds-iam and does not use DATABASE_URL.
DB_AUTH_MODE=url
# Production-only, non-secret values (inject through ECS configuration):
# DB_AUTH_MODE=rds-iam
# DB_HOST=<writer endpoint copied from RDS Connectivity & security>
# DB_PORT=5432
# DB_NAME=<database name>
# DB_USER=<IAM-enabled PostgreSQL user>
# AWS_REGION=us-east-1
# Aurora Express internet access gateway: leave DB_SSL_CA_PATH unset (public roots).
# Explicit custom CA override for standard/private RDS only:
# DB_SSL_CA_PATH=/app/certs/global-bundle.pem
# DB_POOL_MAX=5
# DB_CONNECT_TIMEOUT_MS=5000
# DB_MIGRATION_TIMEOUT_MS=600000
# Migration task only: enable temporary sanitized checks; disabled unless exactly true.
# MIGRATION_DIAGNOSTICS=true
POSTGRES_USER=invoiceguard
POSTGRES_PASSWORD=local_dev_only
POSTGRES_DB=invoiceguard
PORT=3001
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
# Set to 1 behind a single trusted ALB; keep 0 for direct connections.
TRUST_PROXY_HOPS=0
SEED_OWNER_PASSWORD=replace-with-a-local-password
SEED_REVIEWER_PASSWORD=replace-with-another-local-password
# Production seed task only: inject distinct passwords as ECS secrets and opt in.
# SEED_PRODUCTION_CONFIRM=true
# Server-side Gemini analysis only; never expose through VITE_* variables.
GEMINI_API_KEY=

# Choose a Gemini model available to your API project.
GEMINI_MODEL=gemini-3.1-flash-lite
